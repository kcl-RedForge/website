---
import Mark from './Mark.astro';
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
---
<span class:list={['lockup', size]}>
  <Mark class="lockup-mark" />
  <span class="lockup-text">
    <span class="label">KCL</span>
    <span class="wordmark">REDFORGE</span>
  </span>
</span>
<style>
  .lockup { display: inline-flex; align-items: stretch; gap: 0.9em; color: var(--ink); }
  .lockup :global(.lockup-mark) { height: 2.4em; width: 4.46em; flex: none; display: block; }
  .lockup-text { display: flex; flex-direction: column; justify-content: space-between; padding: 0.1em 0; }
  .lockup .label { font-size: 0.62em; line-height: 1; }
  .lockup .wordmark { font-size: 1em; line-height: 0.73; }
  .sm { font-size: 17px; }
  .lg { font-size: clamp(26px, 6vw, 64px); gap: 0.75em; }
  .lg :global(.lockup-mark) { height: 2.35em; width: 4.37em; }
  .lg .label { font-size: 0.3em; }
</style>
